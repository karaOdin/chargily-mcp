# ============================================================================
# CHARGILY MCP PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Choose either PostgreSQL or MySQL by updating the provider in prisma/schema.prisma

# PostgreSQL (Recommended for production)
DATABASE_URL="postgresql://chargily:DANTEjoker@localhost:5432/chargily_mcp?schema=public"

# MySQL (Alternative - uncomment to use)
# DATABASE_URL="mysql://root:DANTEjoker@localhost:3306/chargily_mcp"

# SQLite (Development only - uncomment to use)
# DATABASE_URL="file:./dev.db"

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION
# ----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ----------------------------------------------------------------------------
# CHARGILY PAY API
# ----------------------------------------------------------------------------
# Get your API keys from https://pay.chargily.net/dashboard

# Test mode (sandbox)
CHARGILY_TEST_API_KEY="test_sk_your_test_key_here"

# Live mode (production)
CHARGILY_LIVE_API_KEY="live_sk_your_live_key_here"

# Operating mode: "sandbox" or "production"
CHARGILY_MODE="sandbox"

# Webhook secret for signature verification
CHARGILY_WEBHOOK_SECRET="your_webhook_secret_here"

# ----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_TOKEN_TTL=3600      # 1 hour in seconds
JWT_REFRESH_TOKEN_TTL=2592000  # 30 days in seconds

# OAuth 2.0
OAUTH_ISSUER="https://api.chargily-mcp.com"
OAUTH_AUTHORIZATION_CODE_TTL=600    # 10 minutes
OAUTH_ACCESS_TOKEN_TTL=3600         # 1 hour
OAUTH_REFRESH_TOKEN_TTL=2592000     # 30 days

# API Key configuration
API_KEY_PREFIX="chargily_"
API_KEY_TEST_PREFIX="test_sk_"
API_KEY_LIVE_PREFIX="live_sk_"

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

# CORS
CORS_ORIGIN="*"
CORS_CREDENTIALS="true"

# Request limits
MAX_REQUEST_SIZE="10mb"
REQUEST_TIMEOUT=30000  # 30 seconds

# ----------------------------------------------------------------------------
# APPROVAL WORKFLOW
# ----------------------------------------------------------------------------
# Approval tiers thresholds (in Algerian centimes)
APPROVAL_TIER1_MIN=0
APPROVAL_TIER1_MAX=5000       # 50 DZD - Auto-approve
APPROVAL_TIER2_MAX=100000     # 1,000 DZD - Single approval
APPROVAL_TIER3_MAX=999999999  # Unlimited - Dual approval

# Approval expiration
APPROVAL_EXPIRATION_SECONDS=300  # 5 minutes

# ----------------------------------------------------------------------------
# NOTIFICATIONS
# ----------------------------------------------------------------------------
# Email (SendGrid, SES, etc.)
EMAIL_ENABLED="false"
EMAIL_FROM="noreply@chargily-mcp.com"
EMAIL_PROVIDER="sendgrid"  # sendgrid, ses, smtp
EMAIL_API_KEY=""

# SMTP (if using SMTP provider)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# Slack
SLACK_ENABLED="false"
SLACK_WEBHOOK_URL=""

# Webhooks for approvals
APPROVAL_WEBHOOK_URL=""

# ----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# ----------------------------------------------------------------------------
# Prometheus
PROMETHEUS_ENABLED="true"
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED="true"
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD="admin"

# Logging
LOG_LEVEL="info"  # error, warn, info, debug, trace
LOG_FORMAT="json"  # json, pretty

# Error tracking (Sentry, etc.)
SENTRY_ENABLED="false"
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100  # Per window

# Per-tier limits
RATE_LIMIT_TIER1=100   # Free tier
RATE_LIMIT_TIER2=1000  # Pro tier
RATE_LIMIT_TIER3=10000 # Enterprise tier

# ----------------------------------------------------------------------------
# MULTI-TENANCY
# ----------------------------------------------------------------------------
MULTI_TENANT_ENABLED="true"
DEFAULT_TENANT_ID="default"

# ----------------------------------------------------------------------------
# TESTING
# ----------------------------------------------------------------------------
# Test database (separate from production)
TEST_DATABASE_URL="postgresql://chargily:DANTEjoker@localhost:5432/chargily_mcp_test"
TEST_REDIS_URL="redis://localhost:6379/1"

# ----------------------------------------------------------------------------
# DEPLOYMENT
# ----------------------------------------------------------------------------
# Application version
APP_VERSION="1.0.0"
APP_NAME="Chargily MCP Platform"

# Base URLs
API_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# Health checks
HEALTH_CHECK_ENABLED="true"

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000

# ----------------------------------------------------------------------------
# DOCKER
# ----------------------------------------------------------------------------
POSTGRES_USER="chargily"
POSTGRES_PASSWORD="DANTEjoker"
POSTGRES_DB="chargily_mcp"

MYSQL_ROOT_PASSWORD="DANTEjoker"
MYSQL_DATABASE="chargily_mcp"
MYSQL_USER="chargily"
MYSQL_PASSWORD="DANTEjoker"
